{
  "description": "The request body for creating a policy configuration.",
  "properties": {
    "configurationRef": {
      "description": "A reference to the Configuration CR that holds all the needed configuration for this resource. OASGen Provider added this field automatically.",
      "properties": {
        "name": {
          "type": "string"
        },
        "namespace": {
          "description": "Namespace of the referenced Configuration CR. If not provided, the same namespace will be used.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "isBlocking": {
      "description": "Indicates whether the policy is blocking.",
      "type": "boolean"
    },
    "isDeleted": {
      "description": "Indicates whether the policy has been (soft) deleted.",
      "type": "boolean"
    },
    "isEnabled": {
      "description": "Indicates whether the policy is enabled.",
      "type": "boolean"
    },
    "isEnterpriseManaged": {
      "description": "If set, this policy requires \"Manage Enterprise Policies\" permission to create, edit, or delete.",
      "type": "boolean"
    },
    "organization": {
      "description": "PARAMETER: path - The name of the Azure DevOps organization.",
      "type": "string"
    },
    "project": {
      "description": "PARAMETER: path - Project ID or project name",
      "type": "string"
    },
    "settings": {
      "description": "The settings for a particular policy configuration.",
      "properties": {
        "addedFilesOnly": {
          "type": "boolean"
        },
        "buildDefinitionId": {
          "type": "integer"
        },
        "creatorVoteCounts": {
          "type": "boolean"
        },
        "enforceConsistentCase": {
          "type": "boolean"
        },
        "filenamePatterns": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "manualQueueOnly": {
          "type": "boolean"
        },
        "maximumGitBlobSizeInBytes": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "minimumApproverCount": {
          "type": "integer"
        },
        "queueOnSourceUpdateOnly": {
          "type": "boolean"
        },
        "requiredReviewerIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "scope": {
          "items": {
            "description": "A scope for a policy configuration.",
            "properties": {
              "matchKind": {
                "description": "The match kind of the ref name.",
                "enum": [
                  "Exact",
                  "Prefix"
                ],
                "type": "string"
              },
              "refName": {
                "description": "The reference name of the scope.",
                "type": "string"
              },
              "repositoryId": {
                "description": "The repository ID of the scope.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "useSquashMerge": {
          "type": "boolean"
        },
        "useUncompressedSize": {
          "type": "boolean"
        },
        "validDuration": {
          "type": "string"
        }
      },
      "type": "object",
      "x-crdgen-identifier-name": "Settings1"
    },
    "type": {
      "description": "The policy type.",
      "properties": {
        "id": {
          "description": "The policy type ID. (format: uuid)",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  "required": [
    "isBlocking",
    "organization",
    "project",
    "configurationRef"
  ],
  "type": "object"
}