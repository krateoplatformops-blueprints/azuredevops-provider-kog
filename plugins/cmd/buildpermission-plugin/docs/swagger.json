{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Simple wrapper around Azure DevOps API to provide consistency of API response for Krateo Operator Generator (KOG)",
        "title": "Azure DevOps BuildPermission Plugin API for Krateo Operator Generator (KOG)",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "Krateo Support",
            "url": "https://krateo.io",
            "email": "contact@krateoplatformops.io"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/plugin/buildpermission/{organization}/{projectId}": {
            "get": {
                "description": "Retrieve the permissions for a specific build definition in Azure DevOps",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Build Permissions"
                ],
                "summary": "Get build permissions",
                "operationId": "get-buildpermission",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Organization name",
                        "name": "organization",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Project ID",
                        "name": "projectId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Build Definition ID",
                        "name": "buildDefinitionId",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Type of identity (e.g., 'azure-group', 'build-service')",
                        "name": "identityType",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Name of the identity (e.g., Contributors), not used if identityType is 'build-service' or if identityDescriptor is provided",
                        "name": "identityName",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Descriptor of the identity, has priority over identityType and identityName",
                        "name": "identityDescriptor",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "default": false,
                        "description": "Whether to manage permissions at the project level (true) or build level (pipeline level) (false). Default is false.",
                        "name": "projectLevel",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "API version (e.g., 7.2-preview.2)",
                        "name": "api-version",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Basic Auth header",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Retrieved build permission",
                        "schema": {
                            "$ref": "#/definitions/buildpermission.BuildPermissionResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "post": {
                "description": "Set or update the permissions for a specific build definition in Azure DevOps. Identity information comes from the request body.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Build Permissions"
                ],
                "summary": "Set build permissions",
                "operationId": "post-buildpermission",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Organization name",
                        "name": "organization",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Project ID",
                        "name": "projectId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Build Definition ID",
                        "name": "buildDefinitionId",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "default": false,
                        "description": "Whether to manage permissions at the project level (true) or build level (pipeline level) (false). Default is false.",
                        "name": "projectLevel",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "API version (e.g., 7.2-preview.2)",
                        "name": "api-version",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Basic Auth header",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Permission settings to apply. Identity info (type, name, descriptor) is specified in permissions.identity.",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/buildpermission.BuildPermissionRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Updated build permission",
                        "schema": {
                            "$ref": "#/definitions/buildpermission.BuildPermissionResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "buildpermission.BuildPermissionIdentity": {
            "type": "object",
            "properties": {
                "descriptor": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "buildpermission.BuildPermissionRequest": {
            "type": "object",
            "properties": {
                "permissions": {
                    "$ref": "#/definitions/buildpermission.PermissionsInfo"
                }
            }
        },
        "buildpermission.BuildPermissionResponse": {
            "type": "object",
            "properties": {
                "buildDefinitionId": {
                    "type": "string"
                },
                "organization": {
                    "type": "string"
                },
                "permissions": {
                    "$ref": "#/definitions/buildpermission.PermissionsInfo"
                },
                "projectId": {
                    "type": "string"
                },
                "projectLevel": {
                    "type": "boolean"
                }
            }
        },
        "buildpermission.PermissionsInfo": {
            "type": "object",
            "properties": {
                "allow": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "boolean"
                    }
                },
                "deny": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "boolean"
                    }
                },
                "identity": {
                    "$ref": "#/definitions/buildpermission.BuildPermissionIdentity"
                }
            }
        }
    }
}